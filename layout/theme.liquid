<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="bc-no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.font_body.system? and settings.font_heading.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- liquid
      assign body_font = settings.font_body
      assign body_bold = body_font | font_modify: 'weight', 'bold'
      assign heading_font = settings.font_heading
      assign type_scale = settings.type_scale | divided_by: 100.0
    -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ body_bold | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}

      :root {
        /* Brand tokens */
        --bc-bg: {{ settings.color_background }};
        --bc-surface: {{ settings.color_surface }};
        --bc-text: {{ settings.color_text }};
        --bc-text-muted: {{ settings.color_text_muted }};
        --bc-accent: {{ settings.color_accent }};
        --bc-accent-text: {{ settings.color_accent_text }};
        --bc-secondary: {{ settings.color_secondary }};
        --bc-highlight: {{ settings.color_highlight }};

        /* Typography */
        --bc-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --bc-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --bc-type-scale: {{ type_scale }};

        /* Layout */
        --bc-page-width: {{ settings.page_width }}px;
        --bc-section-spacing: {{ settings.section_spacing }}px;
        --bc-section-spacing-mobile: {{ settings.section_spacing | times: 0.65 | round: 0 }}px;
      }
    {% endstyle %}

    <script>document.documentElement.classList.replace('bc-no-js','bc-js');</script>

    {%- if settings.cart_type == 'drawer' -%}
      <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="bc-page bc-template--{{ template | replace: '.', '-' | handle }}">
    <a class="bc-skip" href="#bc-main">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="bc-main" class="bc-main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.loading' | t }}</li>
    </ul>
  </body>
</html>

[
  {
    "name": "theme_info",
    "theme_name": "Basicariche",
    "theme_version": "2.0.0",
    "theme_author": "Basi Cariche",
    "theme_documentation_url": "https://github.com/livio-fucix/basicariche-shopify-tema-uno",
    "theme_support_url": "https://github.com/livio-fucix/basicariche-shopify-tema-uno/issues"
  },
  {
    "name": "t:settings.brand.heading",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.brand.logo.label"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 240,
        "step": 5,
        "default": 120,
        "unit": "px",
        "label": "t:settings.brand.logo_width.label"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.brand.favicon.label"
      }
    ]
  },
  {
    "name": "t:settings.colors.heading",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "default": "#FFFFFF",
        "label": "t:settings.colors.background.label"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "#FAF7F2",
        "label": "t:settings.colors.surface.label",
        "info": "t:settings.colors.surface.info"
      },
      {
        "type": "color",
        "id": "color_text",
        "default": "#0F1419",
        "label": "t:settings.colors.text.label"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "default": "#5A6470",
        "label": "t:settings.colors.text_muted.label"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "#D2381F",
        "label": "t:settings.colors.accent.label",
        "info": "t:settings.colors.accent.info"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "default": "#FFFFFF",
        "label": "t:settings.colors.accent_text.label"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "default": "#0F2F5C",
        "label": "t:settings.colors.secondary.label"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "default": "#F4C842",
        "label": "t:settings.colors.highlight.label",
        "info": "t:settings.colors.highlight.info"
      }
    ]
  },
  {
    "name": "t:settings.typography.heading",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_body",
        "default": "assistant_n4",
        "label": "t:settings.typography.font_body.label"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "default": "assistant_n7",
        "label": "t:settings.typography.font_heading.label"
      },
      {
        "type": "range",
        "id": "type_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "default": 100,
        "unit": "%",
        "label": "t:settings.typography.scale.label"
      }
    ]
  },
  {
    "name": "t:settings.layout.heading",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1080,
        "max": 1600,
        "step": 20,
        "default": 1280,
        "unit": "px",
        "label": "t:settings.layout.page_width.label"
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 24,
        "max": 96,
        "step": 4,
        "default": 56,
        "unit": "px",
        "label": "t:settings.layout.section_spacing.label"
      }
    ]
  },
  {
    "name": "t:settings.cart.heading",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "options": [
          { "value": "drawer", "label": "t:settings.cart.type.drawer" },
          { "value": "page", "label": "t:settings.cart.type.page" }
        ],
        "default": "drawer",
        "label": "t:settings.cart.type.label"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "default": false,
        "label": "t:settings.cart.show_note.label"
      }
    ]
  },
  {
    "name": "t:settings.product_card.heading",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "default": false,
        "label": "t:settings.product_card.show_vendor.label"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "default": true,
        "label": "t:settings.product_card.show_secondary_image.label"
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "default": true,
        "label": "t:settings.product_card.quick_add.label",
        "info": "t:settings.product_card.quick_add.info"
      }
    ]
  }
]

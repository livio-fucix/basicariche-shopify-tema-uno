{%- if section.settings.menu != blank -%}
  <nav class="bc-pills" aria-label="{{ section.settings.heading | default: 'Categorie' | escape }}">
    <div class="bc-container">
      <ul class="bc-pills__list">
        {%- for link in linklists[section.settings.menu].links -%}
          {%- assign is_active = false -%}
          {%- if link.active or link.child_active -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <li class="bc-pills__item">
            <a
              href="{{ link.url }}"
              class="bc-pills__pill{% if is_active %} bc-pills__pill--active{% endif %}"
              {% if is_active %}aria-current="page"{% endif %}
            >
              {{ link.title | escape }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.category_pills.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (per screen reader)",
      "default": "Categorie"
    }
  ],
  "presets": [
    { "name": "t:sections.category_pills.name" }
  ]
}
{% endschema %}

<section class="bc-section bc-banner{% if section.settings.full_bleed %} bc-banner--full{% endif %}" style="--banner-height: {{ section.settings.height }}px;">
  <div class="{% unless section.settings.full_bleed %}bc-container{% endunless %}">
    <div class="bc-banner__inner">
      {%- if section.settings.image != blank -%}
        <img
          class="bc-banner__image"
          src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1800 }} 1800w, {{ section.settings.image | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="bc-banner__placeholder"></div>
      {%- endif -%}

      {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.cta_label != blank -%}
        <div class="bc-banner__content bc-banner__content--{{ section.settings.alignment }}">
          {%- if section.settings.heading != blank -%}
            <h1 class="bc-banner__heading">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <p class="bc-banner__text">{{ section.settings.text }}</p>
          {%- endif -%}
          {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
            <a href="{{ section.settings.cta_link }}" class="bc-button bc-button--primary">{{ section.settings.cta_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_banner.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Immagine" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Pronti per la prossima stagione" },
    { "type": "text", "id": "text", "label": "Testo", "default": "Guanti, mazze, accessori. Tutto quello che serve in campo." },
    { "type": "text", "id": "cta_label", "label": "Pulsante", "default": "Esplora il catalogo" },
    { "type": "url", "id": "cta_link", "label": "Link pulsante" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Allineamento contenuto",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Destra" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Altezza (desktop)",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "A tutta larghezza",
      "default": true
    }
  ],
  "presets": [{ "name": "t:sections.image_banner.name" }]
}
{% endschema %}

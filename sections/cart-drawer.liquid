<bc-cart-drawer id="bc-cart-drawer" class="bc-drawer" aria-hidden="true">
  <div class="bc-drawer__overlay" data-bc-drawer-close></div>
  <aside class="bc-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="bc-cart-drawer-title">
    <header class="bc-drawer__header">
      <h2 class="bc-drawer__title" id="bc-cart-drawer-title" data-bc-cart-title>
        {%- if cart.item_count > 0 -%}
          {%- if cart.item_count == 1 -%}
            {{ 'cart.title_with_count_one' | t: count: cart.item_count }}
          {%- else -%}
            {{ 'cart.title_with_count_other' | t: count: cart.item_count }}
          {%- endif -%}
        {%- else -%}
          {{ 'cart.title' | t }}
        {%- endif -%}
      </h2>
      <button type="button" class="bc-drawer__close" data-bc-drawer-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', name: 'close' %}
      </button>
    </header>

    <div class="bc-drawer__body" data-bc-cart-body>
      {%- if cart.item_count == 0 -%}
        <div class="bc-drawer__empty">
          <p class="bc-drawer__empty-text">{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="bc-button bc-button--primary">{{ 'cart.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        <ul class="bc-drawer__items" data-bc-cart-items>
          {%- for item in cart.items -%}
            <li class="bc-drawer__item" data-bc-cart-item data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="bc-drawer__item-thumb" tabindex="-1">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy">
                {%- endif -%}
              </a>
              <div class="bc-drawer__item-body">
                <a href="{{ item.url }}" class="bc-drawer__item-title">{{ item.product.title | escape }}</a>
                {%- if item.product.has_only_default_variant == false -%}
                  <p class="bc-drawer__item-options">{{ item.variant.title }}</p>
                {%- endif -%}
                <div class="bc-drawer__item-row">
                  <bc-quantity-input class="bc-qty" data-key="{{ item.key }}">
                    <button type="button" class="bc-qty__btn" data-bc-qty="decrement" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                    <input
                      type="number"
                      class="bc-qty__input"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      aria-label="{{ 'products.quantity' | t }}"
                      data-bc-qty-input
                    >
                    <button type="button" class="bc-qty__btn" data-bc-qty="increment" aria-label="{{ 'products.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                  </bc-quantity-input>
                  <span class="bc-drawer__item-price">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <footer class="bc-drawer__footer" data-bc-cart-footer {% if cart.item_count == 0 %}hidden{% endif %}>
      <div class="bc-drawer__totals">
        <span class="bc-drawer__totals-label">{{ 'cart.total' | t }}</span>
        <span class="bc-drawer__totals-value" data-bc-cart-total>{{ cart.total_price | money_with_currency }}</span>
      </div>
      <p class="bc-drawer__taxes-note">{{ 'cart.taxes_included' | t }}</p>
      <div class="bc-drawer__ctas">
        <form action="{{ routes.cart_url }}" method="post" novalidate>
          <button type="submit" name="checkout" class="bc-button bc-button--primary bc-button--full">{{ 'cart.checkout' | t }}</button>
        </form>
        <button type="button" class="bc-button bc-button--outline bc-button--full" data-bc-drawer-close>{{ 'cart.continue_shopping' | t }}</button>
      </div>
    </footer>
  </aside>
</bc-cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [],
  "enabled_on": { "groups": ["*"] }
}
{% endschema %}

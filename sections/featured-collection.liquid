{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_to_show | default: 6
-%}

<section class="bc-section bc-featured">
  <div class="bc-container">
    {%- if section.settings.heading != blank -%}
      <header class="bc-section__header">
        <h2 class="bc-section__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.show_view_all and collection.url != blank -%}
          <a href="{{ collection.url }}" class="bc-section__link">{{ section.settings.view_all_label | default: 'Vedi tutto' }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <div class="bc-grid bc-grid--products" style="--bc-grid-cols-desktop: {{ section.settings.columns_desktop }}; --bc-grid-cols-mobile: {{ section.settings.columns_mobile }};">
        {%- for product in collection.products limit: limit -%}
          {% render 'card-product',
            product: product,
            section_id: section.id,
            quick_add: settings.card_quick_add,
            show_secondary_image: section.settings.show_secondary_image,
            show_vendor: section.settings.show_vendor,
            index: forloop.index0
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="bc-empty">{{ 'products.no_products_in_collection' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Best seller" },
    { "type": "collection", "id": "collection", "label": "Collezione" },
    { "type": "range", "id": "products_to_show", "label": "Prodotti da mostrare", "min": 3, "max": 24, "step": 1, "default": 6 },
    { "type": "range", "id": "columns_desktop", "label": "Colonne desktop", "min": 2, "max": 5, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonne mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Mostra seconda immagine al hover", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Mostra vendor / brand", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Mostra link 'Vedi tutto'", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Etichetta link", "default": "Vedi tutto" }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}

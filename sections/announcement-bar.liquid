{%- if section.settings.text != blank -%}
  <div class="bc-announcement">
    <div class="bc-container bc-announcement__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="bc-announcement__link">{{ section.settings.text }}</a>
      {%- else -%}
        <p class="bc-announcement__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "default": "Spedizione gratuita sopra i 50€",
      "label": "Testo"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (opzionale)"
    }
  ],
  "presets": [
    { "name": "t:sections.announcement_bar.name" }
  ]
}
{% endschema %}

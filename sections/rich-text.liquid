<section class="bc-section bc-richtext bc-richtext--align-{{ section.settings.alignment }}">
  <div class="bc-container">
    <div class="bc-richtext__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="bc-richtext__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'paragraph' -%}
            <div class="bc-richtext__paragraph" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <a href="{{ block.settings.link }}" class="bc-button bc-button--{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Allineamento",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Titolo",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Parla del tuo brand" }
      ]
    },
    {
      "type": "paragraph",
      "name": "Paragrafo",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Testo", "default": "<p>Racconta la storia del tuo negozio.</p>" }
      ]
    },
    {
      "type": "button",
      "name": "Pulsante",
      "settings": [
        { "type": "text", "id": "label", "label": "Etichetta", "default": "Scopri" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "style",
          "label": "Stile",
          "options": [
            { "value": "primary", "label": "Primario" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.rich_text.name" }]
}
{% endschema %}

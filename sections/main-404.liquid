<section class="bc-section bc-404">
  <div class="bc-container bc-404__inner">
    <p class="bc-404__code">404</p>
    <h1 class="bc-404__title">{{ '404.title' | t }}</h1>
    <p class="bc-404__subtitle">{{ '404.subtitle' | t }}</p>
    <a href="{{ routes.root_url }}" class="bc-button bc-button--primary">{{ '404.cta' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "settings": [],
  "enabled_on": { "templates": ["404"] }
}
{% endschema %}

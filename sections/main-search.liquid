<section class="bc-section bc-search">
  <div class="bc-container">
    <header class="bc-search__header">
      <h1 class="bc-search__title">{{ 'search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="bc-search__form">
        <label for="bc-search-input" class="bc-visually-hidden">{{ 'search.placeholder' | t }}</label>
        <input
          type="search"
          name="q"
          id="bc-search-input"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          class="bc-search__input"
          autocomplete="off"
        >
        <button type="submit" class="bc-search__submit" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</button>
      </form>
    </header>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="bc-search__count">
          {%- if search.results_count == 1 -%}
            {{ 'search.results_count_one' | t: count: search.results_count, terms: search.terms }}
          {%- else -%}
            {{ 'search.results_count_other' | t: count: search.results_count, terms: search.terms }}
          {%- endif -%}
        </p>
        {%- paginate search.results by 24 -%}
          <div class="bc-grid bc-grid--products" style="--bc-grid-cols-desktop: 3; --bc-grid-cols-mobile: 1;">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                {% render 'card-product',
                  product: result,
                  section_id: section.id,
                  quick_add: settings.card_quick_add,
                  show_secondary_image: true,
                  index: forloop.index0
                %}
              {%- elsif result.object_type == 'page' -%}
                <article class="bc-search-result">
                  <a href="{{ result.url }}" class="bc-search-result__link">
                    <h3 class="bc-search-result__title">{{ result.title }}</h3>
                    <p class="bc-search-result__excerpt">{{ result.content | strip_html | truncate: 200 }}</p>
                  </a>
                </article>
              {%- elsif result.object_type == 'article' -%}
                <article class="bc-search-result">
                  <a href="{{ result.url }}" class="bc-search-result__link">
                    <h3 class="bc-search-result__title">{{ result.title }}</h3>
                    <p class="bc-search-result__excerpt">{{ result.excerpt_or_content | strip_html | truncate: 200 }}</p>
                  </a>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="bc-pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="bc-pagination__link">{{ 'accessibility.previous' | t }}</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="bc-pagination__link">{{ part.title }}</a>
                {%- else -%}
                  <span class="bc-pagination__current">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="bc-pagination__link">{{ 'accessibility.next' | t }}</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <p class="bc-search__empty">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "settings": [],
  "enabled_on": { "templates": ["search"] }
}
{% endschema %}

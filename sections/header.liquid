<header class="bc-header" data-bc-header>
  <div class="bc-header__bar">
    <div class="bc-container bc-header__inner">
      <button
        type="button"
        class="bc-header__nav-toggle"
        aria-label="{{ 'general.menu' | t }}"
        aria-controls="bc-mobile-nav"
        aria-expanded="false"
        data-bc-mobile-toggle
      >
        {% render 'icon', name: 'menu' %}
      </button>

      <a href="{{ routes.root_url }}" class="bc-header__logo">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: settings.logo_width | times: 2 }}"
            alt="{{ shop.name | escape }}"
            width="{{ settings.logo_width }}"
            height="auto"
            style="--bc-logo-w:{{ settings.logo_width }}px"
          >
        {%- else -%}
          <span class="bc-header__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <nav class="bc-header__nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
        <ul class="bc-header__menu">
          {%- for link in section.settings.menu.links -%}
            <li class="bc-header__menu-item">
              <a
                href="{{ link.url }}"
                class="bc-header__menu-link{% if link.active or link.child_active %} bc-header__menu-link--active{% endif %}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <div class="bc-header__actions">
        <a href="{{ routes.search_url }}" class="bc-header__action" aria-label="{{ 'general.search' | t }}">
          {% render 'icon', name: 'search' %}
        </a>
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="bc-header__action" aria-label="{{ 'customer.account' | t }}">
            {% render 'icon', name: 'user' %}
          </a>
        {%- endif -%}
        <a
          href="{{ routes.cart_url }}"
          class="bc-header__action bc-header__cart"
          aria-label="{{ 'general.open_cart' | t }}"
          {% if settings.cart_type == 'drawer' %}data-bc-open-cart{% endif %}
        >
          {% render 'icon', name: 'cart' %}
          <span class="bc-header__cart-count{% if cart.item_count == 0 %} bc-header__cart-count--empty{% endif %}" data-bc-cart-count>
            {{ cart.item_count }}
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="bc-header__mobile-nav" id="bc-mobile-nav" hidden>
    <ul class="bc-header__mobile-menu">
      {%- for link in section.settings.menu.links -%}
        <li>
          <a href="{{ link.url }}" class="bc-header__mobile-link{% if link.active %} bc-header__mobile-link--active{% endif %}">
            {{ link.title | escape }}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

<section class="bc-section bc-contact">
  <div class="bc-container bc-contact__inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="bc-contact__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="bc-contact__intro">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'contact', class: 'bc-contact__form', novalidate: 'novalidate' -%}
      {%- if form.posted_successfully? -%}
        <p class="bc-contact__success">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="bc-contact__errors">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="bc-contact-name">{{ 'contact.name' | t }}</label>
      <input type="text" id="bc-contact-name" name="contact[name]" autocomplete="name">
      <label for="bc-contact-email">{{ 'contact.email' | t }}</label>
      <input type="email" id="bc-contact-email" name="contact[email]" autocomplete="email" required>
      <label for="bc-contact-phone">{{ 'contact.phone' | t }}</label>
      <input type="tel" id="bc-contact-phone" name="contact[phone]" autocomplete="tel">
      <label for="bc-contact-message">{{ 'contact.message' | t }}</label>
      <textarea id="bc-contact-message" name="contact[body]" rows="5" required></textarea>
      <button type="submit" class="bc-button bc-button--primary">{{ 'contact.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Contattaci" },
    { "type": "richtext", "id": "text", "label": "Testo intro" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}

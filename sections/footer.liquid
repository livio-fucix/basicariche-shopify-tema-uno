{%- liquid
  assign theme_version = '2.0.0'
-%}
<footer class="bc-footer">
  <div class="bc-container">
    <div class="bc-footer__cols">
      <div class="bc-footer__col bc-footer__col--brand">
        {%- if settings.logo != blank -%}
          <img class="bc-footer__logo" src="{{ settings.logo | image_url: width: 240 }}" alt="{{ shop.name | escape }}" width="120">
        {%- else -%}
          <p class="bc-footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="bc-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="bc-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="bc-footer__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <ul class="bc-footer__links">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}" class="bc-footer__link">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'text' -%}
            <div class="bc-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="bc-footer__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <div class="bc-footer__rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="bc-footer__bottom">
      <p class="bc-footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {%- if section.settings.show_policies -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              · <a href="{{ policy.url }}" class="bc-footer__link">{{ policy.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </p>
      <p class="bc-footer__version">Basicariche v{{ theme_version }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Attrezzatura da baseball, dal 1985."
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Mostra link policy del negozio",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Menu" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Testo",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Contatti" },
        { "type": "richtext", "id": "text", "label": "Testo" }
      ]
    }
  ]
}
{% endschema %}

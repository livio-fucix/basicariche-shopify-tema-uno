<section class="bc-section bc-page">
  <div class="bc-container bc-page__inner">
    <header class="bc-page__header">
      <h1 class="bc-page__title">{{ page.title }}</h1>
    </header>
    <div class="bc-page__rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_page.name",
  "settings": [],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}

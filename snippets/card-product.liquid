{% comment %}
  Renders a product card (Basicariche v1.3 — uppa tile layout).

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  - image_shape: {String} Image mask to apply (kept for legacy compatibility, ignored by tile layout)
  - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
  - show_vendor: {Boolean} Show the product vendor. Default: false
  - show_rating: {Boolean} Show the product rating. Default: false
  - extend_height: {Boolean} Card height extends to available container space. Default: true (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - skip_styles: {Boolean} Don't include component styles. Default: false (optional)
  - quick_add: {String} 'none' | 'standard' | 'bulk' | 'inline'. Default: 'none'
  - section_id: {String} The ID of the section that contains this card.
  - horizontal_class: {Boolean} Add a card--horizontal class if set to true. Default: false (optional)
  - horizontal_quick_add: {Boolean} Changes the quick add button styles when set to true. Default: false (optional)
  - placeholder_image: {String} The placeholder image. Default: 'product-apparel-2' (optional)

  Usage:
  {% render 'card-product', card_product: product %}
{% endcomment %}

{%- if settings.card_layout == 'legacy' -%}
  {%- render 'card-product-legacy',
    card_product: card_product,
    media_aspect_ratio: media_aspect_ratio,
    image_shape: image_shape,
    show_secondary_image: show_secondary_image,
    show_vendor: show_vendor,
    show_rating: show_rating,
    extend_height: extend_height,
    lazy_load: lazy_load,
    skip_styles: skip_styles,
    quick_add: quick_add,
    section_id: section_id,
    horizontal_class: horizontal_class,
    horizontal_quick_add: horizontal_quick_add,
    placeholder_image: placeholder_image
  -%}
{%- else -%}
  {%- unless skip_styles -%}
    {{ 'card-product-v2.css' | asset_url | stylesheet_tag }}
    {{ 'component-rating.css' | asset_url | stylesheet_tag }}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {%- endunless -%}

  {%- if card_product and card_product != empty -%}
    {%- liquid
      assign palette = 'red,orange,purple,grey,gold' | split: ','
      assign tile_color = card_product.metafields.custom.card_color | default: ''
      if tile_color == ''
        for tag in card_product.tags
          if tag contains 'card-color-'
            assign tile_color = tag | remove: 'card-color-'
            break
          endif
        endfor
      endif
      if tile_color == ''
        assign cycle_index = forloop.index0 | default: 0
        assign mod_index = cycle_index | modulo: 5
        assign tile_color = palette[mod_index]
      endif

      assign card_blend = card_product.metafields.custom.card_blend | default: 'normal'
      assign is_novelty = false
      if card_product.tags contains 'novita' or card_product.tags contains 'novità' or card_product.tags contains 'new' or card_product.tags contains 'New'
        assign is_novelty = true
      endif

      assign current_variant = card_product.selected_or_first_available_variant
    -%}

    <article
      class="product-card product-card--tile tile--{{ tile_color }}{% if extend_height %} product-card--extend-height{% endif %}{% if card_blend == 'multiply' %} product-card--blend{% endif %}{% if horizontal_class %} product-card--horizontal{% endif %}"
      data-tile-color="{{ tile_color }}"
    >
      <a
        href="{{ card_product.url }}"
        class="product-card__tile"
        aria-labelledby="ProductCardTitle-{{ section_id }}-{{ card_product.id }}"
        tabindex="-1"
      >
        {%- if is_novelty -%}
          <span class="product-card__ribbon" aria-hidden="true">
            <span class="product-card__ribbon-text">NOVITÀ</span>
          </span>
        {%- endif -%}

        {%- if card_product.featured_media -%}
          <img
            class="product-card__image"
            srcset="
              {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
              {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
              {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
              {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
            "
            src="{{ card_product.featured_media | image_url: width: 720 }}"
            sizes="(min-width: 990px) calc((100vw - 130px) / 3), (min-width: 750px) calc((100vw - 120px) / 2), 100vw"
            alt="{{ card_product.featured_media.alt | escape }}"
            {% unless lazy_load == false %}loading="lazy"{% endunless %}
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
          >
          {%- if card_product.media[1] != null and show_secondary_image -%}
            <img
              class="product-card__image product-card__image--secondary"
              srcset="
                {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
              "
              src="{{ card_product.media[1] | image_url: width: 720 }}"
              sizes="(min-width: 990px) calc((100vw - 130px) / 3), (min-width: 750px) calc((100vw - 120px) / 2), 100vw"
              alt=""
              loading="lazy"
              width="{{ card_product.media[1].width }}"
              height="{{ card_product.media[1].height }}"
            >
          {%- endif -%}
        {%- endif -%}

        {%- if card_product.available == false -%}
          <span class="product-card__badge product-card__badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif card_product.compare_at_price > card_product.price -%}
          <span class="product-card__badge product-card__badge--sale">{{ 'products.product.on_sale' | t }}</span>
        {%- endif -%}
      </a>

      <div class="product-card__body">
        <a
          href="{{ card_product.url }}"
          class="product-card__title-link"
          id="ProductCardTitle-{{ section_id }}-{{ card_product.id }}"
        >
          <h3 class="product-card__title" id="title-{{ section_id }}-{{ card_product.id }}">
            {{ card_product.title | escape }}
          </h3>
        </a>

        {%- if show_vendor and card_product.vendor != blank -%}
          <p class="product-card__subtitle">{{ card_product.vendor }}</p>
        {%- elsif card_product.metafields.custom.subtitle != blank -%}
          <p class="product-card__subtitle">{{ card_product.metafields.custom.subtitle }}</p>
        {%- endif -%}

        {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
          <div
            class="rating product-card__rating"
            role="img"
            aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}"
          >
            {% liquid
              assign rating_decimal = 0
              assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
              if decimal >= 0.3 and decimal <= 0.7
                assign rating_decimal = 0.5
              elsif decimal > 0.7
                assign rating_decimal = 1
              endif
            %}
            <span
              aria-hidden="true"
              class="rating-star"
              style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
            ></span>
          </div>
        {%- endif -%}

        {%- assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id -%}

        {% if quick_add == 'inline' %}
          <card-quick-add-inline
            class="card-quick-add-inline no-js-hidden"
            data-section-id="{{ section_id }}"
            data-product-id="{{ card_product.id }}"
          >
            <script type="application/json" data-card-variants>
              {{ card_product.variants | json }}
            </script>
            <product-form data-section-id="{{ section_id }}">
              {%- form 'product',
                card_product,
                id: product_form_id,
                class: 'form card-quick-add-inline__form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                  class="product-variant-id"
                  data-card-variant-id-input
                  {% if current_variant.available == false %}disabled{% endif %}
                >

                {%- if card_product.has_only_default_variant == false -%}
                  <div class="card-quick-add-inline__options">
                    {%- for option in card_product.options_with_values -%}
                      {%- liquid
                        assign option_name_downcased = option.name | downcase
                        assign is_color = false
                        if option_name_downcased contains 'color' or option_name_downcased contains 'colore'
                          assign is_color = true
                        endif
                        assign group_id = 'CardOpt-' | append: section_id | append: '-' | append: card_product.id | append: '-' | append: forloop.index0
                      -%}
                      <fieldset
                        class="card-quick-add-inline__option{% if is_color %} card-quick-add-inline__option--color{% endif %}"
                        data-option-position="{{ forloop.index0 }}"
                      >
                        <legend class="card-quick-add-inline__option-label">{{ option.name }}</legend>
                        <div class="card-quick-add-inline__pills">
                          {%- for value in option.values -%}
                            {%- assign input_id = group_id | append: '-' | append: forloop.index0 -%}
                            <input
                              type="radio"
                              id="{{ input_id }}"
                              name="{{ group_id }}"
                              value="{{ value | escape }}"
                              data-card-option
                              {% if value == option.selected_value %}checked{% endif %}
                            >
                            <label
                              for="{{ input_id }}"
                              class="card-quick-add-inline__pill{% if is_color %} card-quick-add-inline__swatch{% endif %}"
                              {%- if is_color %} style="--swatch-bg: {{ value | downcase | handle }};" data-swatch-name="{{ value | downcase | escape }}"{% endif -%}
                            >
                              {%- if is_color -%}
                                <span class="visually-hidden">{{ value }}</span>
                              {%- else -%}
                                {{ value }}
                              {%- endif -%}
                            </label>
                          {%- endfor -%}
                        </div>
                      </fieldset>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                <div class="card-quick-add-inline__bar">
                  <span class="card-quick-add-inline__price" data-card-price>
                    {%- if current_variant.compare_at_price > current_variant.price -%}
                      <s class="card-quick-add-inline__price-compare">{{ current_variant.compare_at_price | money }}</s>
                    {%- endif -%}
                    <span data-card-price-current>{{ current_variant.price | money }}</span>
                  </span>
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="card-quick-add-inline__submit"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    aria-live="polite"
                    data-card-submit
                    data-sold-out-message="true"
                    {% if current_variant.available == false %}disabled{% endif %}
                  >
                    <span class="visually-hidden" data-card-submit-label>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="card-quick-add-inline__icon" aria-hidden="true">
                      {{- 'icon-cart-empty.svg' | inline_asset_content -}}
                    </span>
                    {%- render 'loading-spinner' -%}
                  </button>
                </div>
              {%- endform -%}
            </product-form>
          </card-quick-add-inline>
        {% else %}
          <div class="product-card__bottom">
            {% render 'price', product: card_product, price_class: 'product-card__price', show_compare_at_price: true %}
            {% if quick_add == 'standard' or quick_add == 'bulk' %}
              <a
                href="{{ card_product.url }}"
                class="product-card__view"
                aria-label="{{ 'products.product.view_full_details' | t }}"
              >
                <span class="card-quick-add-inline__icon" aria-hidden="true">
                  {{- 'icon-cart-empty.svg' | inline_asset_content -}}
                </span>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </article>
  {%- else -%}
    {%- comment -%} Placeholder card {%- endcomment -%}
    <article class="product-card product-card--tile tile--grey product-card--placeholder">
      <div class="product-card__tile">
        {{ 'product-apparel-2' | placeholder_svg_tag: 'product-card__image placeholder-svg' }}
      </div>
      <div class="product-card__body">
        <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
        {% render 'price', placeholder: true, show_compare_at_price: true %}
      </div>
    </article>
  {%- endif -%}
{%- endif -%}

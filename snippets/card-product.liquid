{%- comment -%}
  Renders a product card.

  Accepts:
    - product: {Object} required
    - section_id: {String} required, unique id of the parent section
    - quick_add: {Boolean} default true (show inline quick-add)
    - show_secondary_image: {Boolean} default true
    - show_vendor: {Boolean} default false
    - lazy: {Boolean} default true
    - index: {Number} optional, used to vary visual (we don't tile-color, but useful for animations)
{%- endcomment -%}

{%- liquid
  assign quick_add = quick_add | default: true
  if quick_add == false
    assign quick_add_enabled = false
  else
    assign quick_add_enabled = true
  endif

  if show_secondary_image == nil
    assign show_secondary_image = settings.card_show_secondary_image
  endif
  if show_vendor == nil
    assign show_vendor = settings.card_show_vendor
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign has_options = false
  if product.has_only_default_variant == false
    assign has_options = true
  endif

  assign is_novelty = false
  if product.tags contains 'novita' or product.tags contains 'novità' or product.tags contains 'new' or product.tags contains 'New'
    assign is_novelty = true
  endif

  assign on_sale = false
  if current_variant.compare_at_price and current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif

  assign card_form_id = 'bc-card-form-' | append: section_id | append: '-' | append: product.id
-%}

<article class="bc-card{% if product.available == false %} bc-card--soldout{% endif %}" data-product-id="{{ product.id }}">
  <a class="bc-card__media-link" href="{{ product.url | within: collection }}" aria-labelledby="bc-card-title-{{ section_id }}-{{ product.id }}" tabindex="-1">
    <div class="bc-card__media">
      {%- if product.featured_media -%}
        <img
          class="bc-card__image bc-card__image--primary"
          srcset="
            {%- if product.featured_media.width >= 360 -%}{{ product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if product.featured_media.width >= 540 -%}{{ product.featured_media | image_url: width: 540 }} 540w,{%- endif -%}
            {%- if product.featured_media.width >= 720 -%}{{ product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
            {%- if product.featured_media.width >= 960 -%}{{ product.featured_media | image_url: width: 960 }} 960w,{%- endif -%}
            {{ product.featured_media | image_url }} {{ product.featured_media.width }}w
          "
          src="{{ product.featured_media | image_url: width: 720 }}"
          sizes="(min-width: 990px) calc((100vw - 80px) / 3), (min-width: 750px) calc((100vw - 60px) / 2), 100vw"
          alt="{{ product.featured_media.alt | escape | default: product.title | escape }}"
          width="{{ product.featured_media.width }}"
          height="{{ product.featured_media.height }}"
          {% if lazy != false %}loading="lazy"{% endif %}
        >
        {%- if show_secondary_image and product.media[1] -%}
          <img
            class="bc-card__image bc-card__image--secondary"
            srcset="
              {%- if product.media[1].width >= 540 -%}{{ product.media[1] | image_url: width: 540 }} 540w,{%- endif -%}
              {%- if product.media[1].width >= 720 -%}{{ product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
              {{ product.media[1] | image_url }} {{ product.media[1].width }}w
            "
            src="{{ product.media[1] | image_url: width: 720 }}"
            sizes="(min-width: 990px) calc((100vw - 80px) / 3), (min-width: 750px) calc((100vw - 60px) / 2), 100vw"
            alt=""
            width="{{ product.media[1].width }}"
            height="{{ product.media[1].height }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'bc-card__placeholder' }}
      {%- endif -%}

      {%- if is_novelty -%}
        <span class="bc-card__ribbon" aria-hidden="true">
          <span class="bc-card__ribbon-text">{{ 'products.novelty' | t }}</span>
        </span>
      {%- endif -%}

      {%- if product.available == false -%}
        <span class="bc-card__badge bc-card__badge--soldout">{{ 'products.sold_out' | t }}</span>
      {%- elsif on_sale -%}
        <span class="bc-card__badge bc-card__badge--sale">{{ 'products.on_sale' | t }}</span>
      {%- endif -%}
    </div>
  </a>

  <div class="bc-card__body">
    <a class="bc-card__title-link" href="{{ product.url | within: collection }}" id="bc-card-title-{{ section_id }}-{{ product.id }}">
      <h3 class="bc-card__title">{{ product.title | escape }}</h3>
    </a>

    {%- if show_vendor and product.vendor != blank -%}
      <p class="bc-card__vendor">{{ product.vendor }}</p>
    {%- endif -%}

    {%- if quick_add_enabled and product.available -%}
      <bc-product-form class="bc-card__form" data-section="{{ section_id }}" data-product="{{ product.id }}">
        <script type="application/json" data-bc-variants>{{ product.variants | json }}</script>
        <form action="{{ routes.cart_add_url }}" method="post" novalidate data-bc-form>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-bc-variant-id>
          <input type="hidden" name="quantity" value="1">

          {%- if has_options -%}
            <div class="bc-card__options">
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign opt_name_lower = option.name | downcase
                  assign is_color = false
                  if opt_name_lower contains 'color' or opt_name_lower contains 'colore'
                    assign is_color = true
                  endif
                  assign opt_id = 'bc-opt-' | append: section_id | append: '-' | append: product.id | append: '-' | append: forloop.index0
                -%}
                <fieldset class="bc-card__option{% if is_color %} bc-card__option--color{% endif %}" data-bc-option-position="{{ forloop.index0 }}">
                  <legend class="bc-card__option-label">{{ option.name }}</legend>
                  <div class="bc-card__option-values">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign input_id = opt_id | append: '-' | append: forloop.index0
                        assign value_handle = value | downcase | handle
                      -%}
                      <input
                        type="radio"
                        id="{{ input_id }}"
                        name="{{ opt_id }}"
                        value="{{ value | escape }}"
                        data-bc-option-value
                        {% if value == option.selected_value %}checked{% endif %}
                      >
                      <label
                        for="{{ input_id }}"
                        class="bc-card__option-pill{% if is_color %} bc-card__option-pill--color{% endif %}"
                        {%- if is_color %} data-bc-color="{{ value_handle }}"{% endif -%}
                      >
                        {%- if is_color -%}
                          <span class="bc-visually-hidden">{{ value }}</span>
                          <span class="bc-card__color-swatch" aria-hidden="true"></span>
                        {%- else -%}
                          {{ value }}
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="bc-card__bottom">
            {% render 'price', variant: current_variant, class: 'bc-card__price' %}
            <button
              type="submit"
              class="bc-card__cta"
              data-bc-submit
              aria-label="{{ 'products.add_to_cart' | t }}"
              {% if current_variant.available == false %}disabled{% endif %}
            >
              <span class="bc-visually-hidden" data-bc-cta-label>{{ 'products.add_to_cart' | t }}</span>
              {% render 'icon', name: 'cart' %}
              <span class="bc-card__cta-spinner" aria-hidden="true" data-bc-spinner></span>
            </button>
          </div>
        </form>
      </bc-product-form>
    {%- else -%}
      <div class="bc-card__bottom">
        {% render 'price', product: product, class: 'bc-card__price' %}
        <a href="{{ product.url | within: collection }}" class="bc-card__cta bc-card__cta--link" aria-label="{{ 'products.view_details' | t }}">
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</article>

{%- comment -%}
  Renders a price block.
  Accepts:
    - product: {Object} (optional, falls back to variant)
    - variant: {Object} (optional)
    - placeholder: {Boolean} (optional, when there is no product)
    - class: {String} extra css classes (optional)
{%- endcomment -%}

{%- liquid
  if variant != null
    assign target = variant
    assign price = variant.price
    assign compare_at = variant.compare_at_price
    assign available = variant.available
  elsif product != null
    assign target = product
    assign price = product.price
    assign compare_at = product.compare_at_price
    assign available = product.available
    assign price_min = product.price_min
    assign price_max = product.price_max
  endif
-%}

<span class="bc-price{% if class %} {{ class }}{% endif %}{% if compare_at and compare_at > price %} bc-price--on-sale{% endif %}{% if available == false %} bc-price--sold-out{% endif %}">
  {%- if placeholder -%}
    <span class="bc-price__current">{{ 1999 | money }}</span>
  {%- elsif product != null and price_min != price_max -%}
    <span class="bc-price__from">{{ 'products.from_price' | t: price: price_min | money }}</span>
  {%- else -%}
    {%- if compare_at and compare_at > price -%}
      <span class="bc-price__compare">{{ compare_at | money }}</span>
    {%- endif -%}
    <span class="bc-price__current">{{ price | money }}</span>
  {%- endif -%}
</span>
